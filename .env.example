# cp .env.example .env 후 실제 값으로 채우기. .env는 git에 커밋하지 말 것.
# 여기 값들은 docker-compose.yml -> mc 컨테이너 환경변수 -> config.yml의 ${...} 로
# 컨테이너 기동 시 자동 치환됨 (REPLACE_ENV_IN_PLACE). config.yml을 서버에서 직접 고칠 필요 없음.
#
# 테스트 서버를 별도로 띄우려면 .env.test.example 참고
# (같은 docker-compose.yml을 -p 옵션으로 분리해서 재사용함)

SERVER_NAME=jeminSMPv2
MC_VERSION=1.21.11
MC_MEMORY=4G
RCON_PASSWORD=change-me-rcon

# 학교 등에서 모장 인증이 막혀 접속이 안 될 때만 FALSE로. UUID 브릿지가 있어서
# 오프라인 모드로 돌려도 기존 플레이어 데이터(직업/팀/칭호 등)는 그대로 유지됨.
ONLINE_MODE=TRUE

# 운영 서버 기본 포트/데이터 경로 (테스트 서버는 .env.test에서 다른 값 사용)
MC_PORT=25565
DATA_DIR=./data
MYSQL_DATA_DIR=./mysql-data

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jeminsmpv2
MYSQL_USER=jeminsmpv2
MYSQL_PASSWORD=change-me-password

# Discord 봇 (https://discord.com/developers/applications 에서 발급)
DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=change-me-discord-bot-token
DISCORD_ADMIN_ROLE_ID=change-me-admin-role-id
DISCORD_CHANNEL_EVENTS=change-me-events-channel-id
DISCORD_CHANNEL_CONSOLE=change-me-console-channel-id

# Google Sheets 스케줄 연동 (안 쓰면 비워둬도 됨, config.yml의 google.sheets.enabled: false 로 꺼져있음)
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_SHEET_ID=

# 접속 제한 (운영 서버는 보통 비워둬서 전체 오픈. 테스트 서버에서 잠그는 용도)
WHITELIST_NAMES=
ENFORCE_WHITELIST=false
OPS_NAMES=

# 리소스팩 정적 서빙 포트 (라우터에서 이 포트 포워딩 필요)
RESOURCEPACK_PORT=25564
