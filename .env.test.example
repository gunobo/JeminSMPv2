# 테스트 서버용 .env. cp .env.test.example .env.test 후 값 채우기. git에 커밋 금지.
#
# 실행 방법 (운영 서버와 동시에 띄워도 컨테이너/네트워크/볼륨이 겹치지 않음):
#   docker compose -p jeminsmp-test --env-file .env.test up -d
# 종료:
#   docker compose -p jeminsmp-test --env-file .env.test down

SERVER_NAME=jeminSMPv2-test
MC_VERSION=1.21.11
MC_MEMORY=2G
RCON_PASSWORD=change-me-test-rcon

# 운영 서버와 겹치지 않는 포트/데이터 경로
MC_PORT=25566
DATA_DIR=./data-test
MYSQL_DATA_DIR=./mysql-data-test

MYSQL_ROOT_PASSWORD=change-me-test-root
MYSQL_DATABASE=jeminsmpv2_test
MYSQL_USER=jeminsmpv2_test
MYSQL_PASSWORD=change-me-test-password

# 운영 서버와 같은 디스코드 봇을 그대로 쓰면 채팅 중계가 섞이니 기본적으로 꺼둠.
# 테스트용 봇을 따로 만들 거면 DISCORD_ENABLED=true 로 바꾸고 아래 값 채우기.
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_ADMIN_ROLE_ID=
DISCORD_CHANNEL_EVENTS=
DISCORD_CHANNEL_CONSOLE=

GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_SHEET_ID=

# 본서버 OP만 접속 가능하도록 잠금 — 쉼표로 닉네임 나열
WHITELIST_NAMES=닉네임1,닉네임2,닉네임3
ENFORCE_WHITELIST=true
OPS_NAMES=닉네임1,닉네임2,닉네임3
